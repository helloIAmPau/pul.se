{
  "name": "@pul.se/graphql",
  "version": "0.0.0",
  "scripts": {
    "build": "esbuild index.js --bundle --outdir=dist --platform=node --target=node24.11 --sourcemap --loader:.graphql=text",
    "develop": "npm run build && concurrently 'npm run build -- --watch' 'node --watch dist/index.js'"
  },
  "devDependencies": {
    "@graphql-tools/schema": "10.0.30",
    "concurrently": "9.2.1",
    "esbuild": "0.27.1",
    "express": "5.2.1",
    "graphql-http": "1.22.4"
  }
}
