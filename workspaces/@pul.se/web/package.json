{
  "name": "@pul.se/web",
  "version": "0.0.0",
  "scripts": {
    "build:server": "esbuild index.js --bundle --outdir=dist --platform=node --target=node24.11 --sourcemap --loader:.js=jsx --jsx=automatic --loader:.css=text",
    "build:client": "esbuild client.js --bundle --outdir=dist/assets --sourcemap --loader:.js=jsx --jsx=automatic --loader:.woff2=file",
    "build": "npm run build:server -- --minify && npm run build:client -- --minify",
    "develop:server": "npm run build && concurrently 'npm run build:server -- --watch' 'node --watch dist/index.js'",
    "develop:client": "npm run build:client -- --watch",
    "develop": "concurrently 'npm run develop:server' 'npm run develop:client'"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@phosphor-icons/react": "2.1.10",
    "concurrently": "9.2.1",
    "esbuild": "0.27.1",
    "express": "5.2.1",
    "hls.js": "1.6.15",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.10.1"
  }
}
